# === 应用配置 ===
APP_NAME=TaobaoProductMonitor
LOG_LEVEL=INFO
DEBUG=false

# === 数据库配置 ===
DB_TYPE=sqlite
DB_SQLITE_PATH=db/ProductMonitor.db
# DB_TYPE=mysql
# DB_MYSQL_HOST=localhost
# DB_MYSQL_PORT=3306
# DB_MYSQL_USER=root
# DB_MYSQL_PASSWORD=yourpassword
# DB_MYSQL_DATABASE=product_monitor

# === 邮件配置 ===
MAIL_HOST=smtp.163.com
MAIL_PORT=25
MAIL_SENDER=your@163.com
MAIL_LICENSE_KEY=your_license_key

# === 抓取配置（tbmon，唯一抓取实现）===
# 登录态文件（相对路径按项目根解析）。生成方式：POST /session/login 或 python -m tbmon login
TB_STORAGE_STATE=taobao_storage_state.json
# 抓取时是否隐藏浏览器窗口。扫码登录本身始终使用有头模式；
# 有头（false）更不容易被风控判定，服务端无人值守时可改 true
TB_HEADLESS=false
TB_NAV_TIMEOUT_MS=45000
TB_HTTP_TIMEOUT_S=15
TB_MAX_ATTEMPTS=3
TB_MIN_INTERVAL_S=1.5
TB_APP_KEY=12574478
# 代理留空即不使用（需启用时取消注释并填写，例如 http://127.0.0.1:7890）
# TB_PROXY=

# === 监控调度（服务内嵌）===
MONITOR_SCHEDULE_ENABLED=true
MONITOR_INTERVAL_MINUTES=60
MONITOR_RUN_ON_STARTUP=false
